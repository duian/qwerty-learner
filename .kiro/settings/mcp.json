{
  "mcpServers": {
    "@hb/doc-mcp-server": {
      "command": "npx",
      "args": ["-y", "--registry=http://nodepackages.hellobike.cn:4873/", "@hb/doc-mcp-server@latest", "--stdio"],
      "env": {
        "YUQUE_EXTRA_TOKEN": "scope1:BgfkB6iH1xud6Ija8tTkGcm7wNX0O2yg5K5sbnYZ, scope2:euMCt5wRglVaD6IiVHg1c8v9C1knUfbfRzBSg6Jh",
        "YUQUE_DEFAULT_SEARCH_SCOPE": "scope1,scope2"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-c5764620-db61-4cfb-810e-7273a73e2fc6"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "shrimp-task-manager": {
      "command": "npx",
      "args": ["-y", "mcp-shrimp-task-manager"],
      "env": {
        "DATA_DIR": "docs/task",
        "TEMPLATES_USE": "zh",
        "ENABLE_GUI": "true"
      }
    },
    "mcp-server-time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=Asia/Shanghai"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "/Users/duian/hellobike/work-master/.cursor/memory.json"
      }
    }
  }
}
